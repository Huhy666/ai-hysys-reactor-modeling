# Web server (localhost only by default)
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development

# OpenAI-compatible language-model endpoint. Fill these on the HYSYS workstation.
# DeepSeek official API example: provider=deepseek, base URL without /v1,
# model=deepseek-flash or deepseek-v4-pro.
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Aspen HYSYS execution
HYSYS_VISIBLE=true
HYSYS_PROGID=HYSYS.Application
HYSYS_BASE_CASE_PATH=
HYSYS_PROBE_RESULT_PATH=
HYSYS_RUN_TIMEOUT_SECONDS=300
HYSYS_ARTIFACT_DIR=D:\hhyagent\runs

LOG_LEVEL=INFO
